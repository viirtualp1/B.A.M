{
  "name": "billion-and-million",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:single": "vue-tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "esbuild test/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-singlefile": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
